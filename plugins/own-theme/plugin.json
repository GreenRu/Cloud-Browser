      "variables": {
        "--sky-top": "@sky-top",
        "--sky-bottom": "@sky-bottom",
        "--text-on-sky": "@text-on-sky",
        "--new-cloud-line": "@new-cloud-line 0.6",
        "--scroll-thumb": "@scroll-thumb 0.55",
        "--cloud": "@cloud",
        "--cloud-idle": "@cloud-idle",
        "--cloud-hover": "@cloud-hover",
        "--cloud-bright": "@cloud-bright",
        "--close-veil": "@close-veil 0.62",
        "--text": "@text",
        "--text-dim": "@text-dim",
        "--accent": "@accent",
        "--droplet": "@droplet",
        "--danger": "@danger",
        "--field": "@field",
        "--field-line": "@field-line 0.1",
        "--hover": "@hover 0.5",
        "--panel": "@panel 0.74",
        "--panel-line": "@panel-line 0.55",
        "--bubble": "@bubble",
        "--stage": "@stage",
        "--rain": "@rain",
        "--rain-drop": "@rain-drop 0.85",
        "--pool-deep": "@pool-deep 0.26",
        "--pool-shallow": "@pool-shallow 0.5",
        "--pool-rim": "@pool-rim 0.72",
        "--pool-glow": "@pool-glow 0.55",
        "--pool-sheen": "@pool-sheen 0.85"
      },
      "pageVariables": {
        "--sky-top": "@page-sky-top",
        "--sky-bottom": "@page-sky-bottom",
        "--text": "@page-text",
        "--text-dim": "@page-text-dim",
        "--accent": "@page-accent",
        "--field": "@page-field",
        "--card": "@page-card 0.9",
        "--card-solid": "@page-card-solid",
        "--card-hover": "@page-card-hover",
        "--card-line": "@page-card-line 0.08",
        "--drift-far": "@page-drift-far"
      },
      "fields": [
        {
